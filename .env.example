# --- Environnement (dev | prod)
COMPOSE_ENV=dev

# --- Base de données PostgreSQL
# Ces valeurs sont des exemples pour votre environnement local.
# Ne commitez jamais de vrais identifiants sensibles.
POSTGRES_DB=devops_db
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=change-me

# URL de connexion PostgreSQL utilisée par le backend
# À adapter selon vos valeurs locales.
DATABASE_URL=postgres://devops_user:change-me@postgres:5432/devops_db

# --- Backend
BACKEND_PORT=3000
BACKEND_DOMAIN=api.localhost

# --- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Frontend
FRONTEND_PORT=3001
FRONTEND_DOMAIN=app.localhost

# --- Mailpit (SMTP de test)
# Service de mail de développement uniquement, aucune authentification.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="DevOps Foundations <no-reply@example.test>"

# --- Sécurité (Traefik / Adminer)
# Format attendu: htpasswd (user:hash). Exemple (à générer en local) :
#   htpasswd -nbB admin "mot-de-passe-fort"
# Puis copier la sortie ici.
TRAEFIK_BASIC_AUTH_USERS=
ADMINER_BASIC_AUTH_USERS=
