# --- Environnement (dev | prod)
COMPOSE_ENV=dev

# --- Base de données PostgreSQL
POSTGRES_DB=devops_db
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=change-me

# URL de connexion PostgreSQL utilisée par le backend
# À adapter selon vos valeurs locales.
DATABASE_URL=postgres://devops_user:change-me@postgres:5432/devops_db

# --- Backend
BACKEND_PORT=3000
BACKEND_DOMAIN=api.localhost

# --- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Frontend
FRONTEND_PORT=3001
FRONTEND_DOMAIN=app.localhost
FRONTEND_ORIGINS=https://app.localhost,http://app.localhost,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Accept
VITE_API_BASE_URL=https://api.localhost

# --- Mailpit (SMTP de test)
# Service de mail de développement uniquement, aucune authentification.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="DevOps Foundations <no-reply@example.test>"


TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=change-me-choose-a-long-random-password

